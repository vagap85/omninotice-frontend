# Synora API (без слэша в конце)
VITE_SYNORA_BASE_URL=https://api.synora.example.com

# Топик события для отправки уведомлений (должен быть настроен в Synora)
VITE_SYNORA_EVENT_TOPIC=omninotice_notification

# EmailJS
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
